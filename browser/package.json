{
  "name": "clinsearch-crosswalk-browser",
  "private": true,
  "version": "0.1.0-preview",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsc -p tsconfig.core.json && node --test tests/*.test.mjs",
    "test:parity": "python ../scripts/export_browser_parity.py --check && npm test",
    "format": "prettier --write src tests vite.config.ts tsconfig*.json package.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.8.3",
    "vite": "8.3.0",
    "prettier": "3.6.2"
  }
}
