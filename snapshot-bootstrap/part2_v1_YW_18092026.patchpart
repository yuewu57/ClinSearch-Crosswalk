+"""Terminology adapter tests; conversion engine and old fixtures stay unchanged."""
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).parents[2]
+sys.path.insert(0, str(ROOT / 'browser/python'))
+from mesh_snapshot_v1_YW_18092026 import (  # noqa: E402
+    SnapshotResolver,
+    lookup_descriptor,
+    validate_snapshot,
+)
+from ovid_pubmed_converter.core import convert_strategy  # noqa: E402
+from ovid_pubmed_converter.engine import MeshResolver  # noqa: E402
+from ovid_pubmed_converter.outputs import one_line_query  # noqa: E402
+from ovid_pubmed_converter.parser import parse_strategy_text  # noqa: E402
+
+
+def small_snapshot():
+    return {'schema_version': 2, 'kind': 'mesh-descriptor-exact', 'mesh_year': 2026,
+            'records': {'D000001': ['Action Agents', 'TopicalDescriptor', True],
+                        'D000002': ['Example Review', 'PublicationType', False],
+                        'D000003': ['Active Compound', 'TopicalDescriptor', False]},
+            'preferred': {'action agents': ['D000001'], 'example review': ['D000002'],
+                          'active compound': ['D000003']},
+            'terms': {'action agents': ['D000001', 'D000003'], 'specific agent': ['D000001'],
+                      'ambiguous label': ['D000001', 'D000003']},
+            'historical_aliases': {'old agents': ['D000001', 'Action Agents']}}
+
+
+def convert(source, resolver):
+    return convert_strategy(parse_strategy_text(source), mesh_resolver=resolver)
+
+
+def test_exact_preferred_has_priority_over_entry_collision():
+    snapshot = small_snapshot()
+    validate_snapshot(snapshot)
+    value = lookup_descriptor(snapshot, '  ACTION   agents  ')
+    assert value['descriptor_id'] == 'D000001'
+    assert value['match_type'] == 'preferred'
+
+
+def test_ambiguous_term_is_never_guessed():
+    value = lookup_descriptor(small_snapshot(), 'ambiguous label')
+    assert value['status'] == 'ambiguous'
+    assert len(value['candidate_uris']) == 2
+    result = convert('1 ambiguous label/', SnapshotResolver(small_snapshot()))
+    assert any('mesh_resolution_fallback' in flag for flag in result.rows[0].audit_flags)
+
+
+def test_typo_is_not_fuzzily_repaired():
+    value = lookup_descriptor(small_snapshot(), 'Acti ve Compound')
+    assert value['status'] == 'unresolved'
+
+
+def test_exact_entry_and_existing_alias_remain_distinct():
+    assert lookup_descriptor(small_snapshot(), 'specific agent')['match_type'] == 'entry'
+    assert lookup_descriptor(small_snapshot(), 'old agents')['match_type'] == 'historical'
+
+
+def test_publication_type_and_pa_direction():
+    resolver = SnapshotResolver(small_snapshot())
+    assert one_line_query(convert('1 Example Review/', resolver)) == '"Example Review"[pt]'
+    assert '[pa]' in one_line_query(convert('1 exp Action Agents/', resolver))
+    assert '[pa]' not in one_line_query(convert('1 Action Agents/', resolver))
+    assert '[pa]' not in one_line_query(convert('1 exp Active Compound/', resolver))
+
+
+def test_snapshot_matches_reference_for_identical_metadata():
+    snapshot = small_snapshot()
+    old = MeshResolver(cache_path=None, mode='cache-only')
+    old.records = {k: lookup_descriptor(snapshot, k) for k in snapshot['preferred']}
+    old.mesh_year = 2026
+    source = '1 exp Action Agents/\n2 Example Review/\n3 1 or 2'
+    assert convert(source, SnapshotResolver(snapshot)) == convert(source, old)
+
+
+def test_snapshot_prefetch_does_not_mutate_or_contact_network(monkeypatch):
+    snapshot = small_snapshot()
+    before = json.dumps(snapshot, sort_keys=True)
+    resolver = SnapshotResolver(snapshot)
+    monkeypatch.setattr(resolver, '_request_json', lambda *a, **k: pytest.fail('Network call'))
+    resolver.prefetch(['Action Agents', 'Not Present'])
+    convert('1 exp Action Agents/', resolver)
+    assert json.dumps(snapshot, sort_keys=True) == before
+    assert resolver.dirty is False and resolver.cache_path is None
+
+
+@pytest.mark.parametrize('fault', ['missing_record', 'unknown_class', 'non_boolean_pa',
+                                  'nonunique_candidates', 'scr', 'alias_target'])
+def test_invalid_snapshot_is_rejected(fault):
+    snapshot = small_snapshot()
+    if fault == 'missing_record':
+        snapshot['terms']['bad'] = ['D999999']
+    elif fault == 'unknown_class':
+        snapshot['records']['D000001'][1] = 'SupplementaryConcept'
+    elif fault == 'non_boolean_pa':
+        snapshot['records']['D000001'][2] = 'false'
+    elif fault == 'nonunique_candidates':
+        snapshot['terms']['bad'] = ['D000001', 'D000001']
+    elif fault == 'scr':
+        snapshot['kind'] = 'mesh-supplementary-exact'
+    else:
+        snapshot['historical_aliases']['old agents'] = ['D000003', 'Action Agents']
+    with pytest.raises(ValueError):
+        validate_snapshot(snapshot)
+
+
+def test_original_620_cache_is_byte_preserved():
+    import hashlib
+    path = ROOT / 'resources/mesh_resolution_cache_v20_v1_YW_18092026.json'
+    assert hashlib.sha256(path.read_bytes()).hexdigest() == 'a975dee7b863d6bd74199ded85ffe9f36cb44963e3f897fe5c9c8a3e923e91f1'
+
+
+def test_xml_direct_pa_and_term_collection(tmp_path):
+    spec = importlib.util.spec_from_file_location('builder', ROOT / 'scripts/build_mesh_2026_snapshot_v1_YW_18092026.py')
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    source = tmp_path / 'desc.xml'
+    source.write_text('''<DescriptorRecordSet LanguageCode="eng"><DescriptorRecord DescriptorClass="1">
+    <DescriptorUI>D000003</DescriptorUI><DescriptorName><String>Active Compound</String></DescriptorName>
+    <PharmacologicalActionList><PharmacologicalAction><DescriptorReferredTo><DescriptorUI>D000001</DescriptorUI></DescriptorReferredTo></PharmacologicalAction></PharmacologicalActionList>
+    <ConceptList><Concept><TermList><Term><String>Shared</String></Term><Term><String>Shared</String></Term></TermList></Concept></ConceptList>
+    </DescriptorRecord></DescriptorRecordSet>''', encoding='utf-8')
+    data = module.collect(source, 'descriptor')
+    assert data['terms']['shared'] == ['D000003']
+    assert set(data['actions']) == {'D000001'}
+    assert data['records']['D000003'][2] is False
