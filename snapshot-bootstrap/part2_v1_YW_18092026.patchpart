+        'unknown_boolean_heading': '1 Anal Canal and Neoplasms/',
+        'publication_type': '1 Review/',
+        'check_tag': '1 Male/',
+        'geographical': '1 Scotland/',
+        'pa_exploded': '1 exp Anti-Bacterial Agents/',
+        'pa_ordinary': '1 Anti-Bacterial Agents/',
+        'compound_not_pa_target': '1 exp Calcimycin/',
+        'frequency': '1 cancer.ab./freq=2',
+        'wildcard_phrase': '1 "breast* cancer*"[Title/Abstract]',
+        'limit': '1 exp Narcolepsy/\n2 limit 1 to humans',
+        'update_date': '1 exp Narcolepsy/\n2 2022*.dt.\n3 1 and 2',
+        'multifield': '1 narcolep*.ti,ab.\n2 Narcolepsy/\n3 1 or 2',
+        'invalid': '1 Narcolepsy/\n2 1 and 999',
+    }
+    cases = []
+    for identifier, source in sources.items():
+        result = convert_strategy(parse_strategy_text(source), mesh_resolver=resolver)
+        expected = {'result': asdict(result), 'strategyText': strategy_text(result),
+                    'oneLineQuery': one_line_query(result), 'auditCsv': audit_csv(result),
+                    'convertedRtf': converted_rtf(result).decode('ascii'),
+                    'inputWarnings': [], 'adapterError': None}
+        cases.append({'id': identifier, 'request': {'mode': 'paste', 'source': source},
+                      'expected': expected})
+    (ROOT / 'browser/parity/snapshot-generated.json').write_text(json.dumps(cases) + '\n', encoding='utf-8')
+    print(f'Exported {len(cases)} independently rendered native snapshot cases')
+
+
+if __name__ == '__main__':
+    main()
