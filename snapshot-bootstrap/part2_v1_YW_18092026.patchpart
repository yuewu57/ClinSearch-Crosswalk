@@ -0,0 +1,94 @@
+"""Exact descriptor lookup over a frozen compact MeSH snapshot; no network I/O.
+
+The reference conversion engine is unchanged. SCRs/qualifiers remain separate
+resources and are never guessed to be slash-heading descriptors.
+"""
+from __future__ import annotations
+
+import re
+
+from ovid_pubmed_converter.engine import MeshResolver, _mesh_cache_key, normalize_mesh_lookup_label
+
+CLASSES = {"TopicalDescriptor", "PublicationType", "CheckTag", "GeographicalDescriptor"}
+
+
+def validate_snapshot(snapshot: dict) -> None:
+    if not isinstance(snapshot, dict) or snapshot.get("schema_version") != 2:
+        raise ValueError("browser_snapshot_schema_invalid")
+    if snapshot.get("kind") != "mesh-descriptor-exact" or snapshot.get("mesh_year") != 2026:
+        raise ValueError("browser_snapshot_kind_or_year_invalid")
+    records = snapshot.get("records")
+    if not isinstance(records, dict) or not records:
+        raise ValueError("browser_snapshot_records_invalid")
+    for ui, value in records.items():
+        if (not re.fullmatch(r"D[0-9]+", ui) or not isinstance(value, list) or len(value) != 3
+                or not isinstance(value[0], str) or not value[0] or value[1] not in CLASSES
+                or not isinstance(value[2], bool)):
+            raise ValueError("browser_snapshot_descriptor_invalid")
+    for category in ("preferred", "terms"):
+        index = snapshot.get(category)
+        if not isinstance(index, dict):
+            raise ValueError("browser_snapshot_index_invalid")
+        for key, ids in index.items():
+            if (not isinstance(key, str) or key != _mesh_cache_key(key)
+                    or not isinstance(ids, list) or not ids or ids != sorted(set(ids))
+                    or any(ui not in records for ui in ids)):
+                raise ValueError("browser_snapshot_index_reference_invalid")
+    for ui, value in records.items():
+        if ui not in snapshot["preferred"].get(_mesh_cache_key(value[0]), []):
+            raise ValueError("browser_snapshot_preferred_label_missing")
+    aliases = snapshot.get("historical_aliases", {})
+    if not isinstance(aliases, dict):
+        raise ValueError("browser_snapshot_aliases_invalid")
+    for key, value in aliases.items():
+        if (key != _mesh_cache_key(key) or not isinstance(value, list) or len(value) != 2
+                or value[0] not in records or not isinstance(value[1], str)):
+            raise ValueError("browser_snapshot_alias_invalid")
+        target = _mesh_cache_key(value[1])
+        ids = snapshot["preferred"].get(target) or snapshot["terms"].get(target) or []
+        if ids != [value[0]]:
+            raise ValueError("browser_snapshot_alias_target_invalid")
+
+
+def lookup_descriptor(snapshot: dict, source_label: str) -> dict:
+    """Pure lookup: reviewed aliases > exact preferred labels > exact entry terms."""
+    label = normalize_mesh_lookup_label(source_label)
+    key = _mesh_cache_key(label)
+    alias = snapshot.get("historical_aliases", {}).get(key)
+    if alias:
+        ids, match_type, matched = [alias[0]], "historical", alias[1]
+    elif key in snapshot["preferred"]:
+        ids, match_type, matched = snapshot["preferred"][key], "preferred", label
+    else:
+        ids, match_type, matched = snapshot["terms"].get(key, []), "entry", label
+    if len(ids) != 1:
+        return {"status": "ambiguous" if ids else "unresolved", "source_label": label,
+                "reason": ("multiple_exact_descriptor_matches" if match_type == "preferred"
+                           else "entry_term_maps_to_multiple_descriptors") if ids
+                          else "no_exact_preferred_or_entry_match_in_frozen_snapshot",
+                "candidate_uris": ["http://id.nlm.nih.gov/mesh/" + ui for ui in ids]}
+    ui = ids[0]
+    canonical, record_class, is_pa = snapshot["records"][ui]
+    return {"status": "resolved", "source_label": label, "matched_label": matched,
+            "match_type": match_type, "canonical_label": canonical, "descriptor_id": ui,
+            "descriptor_uri": "http://id.nlm.nih.gov/mesh/" + ui,
+            "record_class": record_class, "is_pharmacological_action": is_pa,
+            "mesh_year": snapshot["mesh_year"]}
+
+
+class SnapshotResolver(MeshResolver):
+    """An immutable terminology adapter for the existing conversion API."""
+
+    def __init__(self, snapshot: dict, *, validated: bool = False):
+        super().__init__(cache_path=None, mode="cache-only")
+        if not validated:
+            validate_snapshot(snapshot)
+        self.snapshot = snapshot
+        self.mesh_year = snapshot["mesh_year"]
+
+    def resolve(self, source_label: str) -> dict:
+        return lookup_descriptor(self.snapshot, source_label)
+
+    def prefetch(self, source_labels, max_workers: int = 4) -> dict[str, dict]:
+        # This never performs I/O or adds session-specific labels to the snapshot.
+        return {_mesh_cache_key(label): self.resolve(label) for label in source_labels}
