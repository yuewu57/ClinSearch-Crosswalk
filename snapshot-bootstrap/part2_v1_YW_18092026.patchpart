@@ -26,0 +27,17 @@
+      let cacheText: string;
+      if (manifest.cacheCompression === 'gzip' && typeof DecompressionStream !== 'undefined') {
+        const response = await fetch(prefix + 'mesh-cache.json.gz', {credentials:'omit', cache:'no-cache'});
+        if (!response.ok) throw new Error('runtime_asset_unavailable');
+        const bytes = new Uint8Array(await response.arrayBuffer());
+        if (bytes[0] === 0x1f && bytes[1] === 0x8b) {
+          const hash = Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', bytes))).map(x=>x.toString(16).padStart(2,'0')).join('');
+          if (hash !== manifest.cacheGzipSha256) throw new Error('runtime_compressed_cache_integrity_failed');
+          cacheText = await new Response(new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'))).text();
+        } else {
+          // A host may already have applied Content-Encoding decoding.
+          // The decompressed content hash is always checked by createRuntime.
+          cacheText = new TextDecoder('utf-8', {fatal:true}).decode(bytes);
+        }
+      } else {
+        cacheText = await asset(prefix + 'mesh-cache.json');
+      }
