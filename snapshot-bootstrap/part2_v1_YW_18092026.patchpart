+@lru_cache(maxsize=1)
+def _read_terminology(cache_json):
+    # Only immutable public terminology is retained, never source strategies/results.
+    cache = json.loads(cache_json)
+    if not isinstance(cache, dict):
+        raise ValueError('browser_cache_schema_invalid')
+    if cache.get('schema_version') == 2:
+        validate_snapshot(cache)
+    elif cache.get('schema_version') != 1 or not isinstance(cache.get('records'), dict):
+        raise ValueError('browser_cache_schema_invalid')
+    return cache
+
+
