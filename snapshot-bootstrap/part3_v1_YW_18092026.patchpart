+test('complete snapshot resolves a heading outside the corpus cache using compressed local assets', async({page})=>{
+  const requests:string[]=[];
+  page.on('request', r=>requests.push(r.url()));
+  await page.goto('/');
+  await convert(page,'1 exp Narcolepsy/');
+  await expect(page.locator('#query')).toHaveValue('"Narcolepsy"[mh]');
+  await expect(page.locator('#warning-list')).not.toContainText('not verified');
+  await expect(page.locator('#audit-body')).toContainText('mesh_resolved:');
+  await expect(page.locator('#preview-notice')).toContainText('267,012 exact labels');
+  expect(requests.some(url=>url.endsWith('/runtime/mesh-cache.json.gz'))).toBeTruthy();
+  expect(requests.some(url=>url.endsWith('/runtime/mesh-cache.json'))).toBeFalsy();
+  expect(requests.every(url=>url.startsWith('http://127.0.0.1:4173/'))).toBeTruthy();
+  const manifest=JSON.parse(await page.locator('#provenance-text').textContent() || '{}');
+  expect(manifest.terminologyProfile).toBe('mesh2026-complete');
+  expect(manifest.cacheSha256).toMatch(/^[0-9a-f]{64}$/);
+});
+
+test('full snapshot applies exact entry labels and does not repair misspellings',async({page})=>{
+  await page.goto('/');await convert(page,'1 Patient Education/');
+  await expect(page.locator('#query')).toHaveValue('"Patient Education as Topic"[mh]');
+  await expect(page.locator('#audit-body')).toContainText('|entry|');
+  await convert(page,'1 Card iac Output/');
+  await expect(page.locator('#query')).toHaveValue('"Card iac Output"[mh]');
+  await expect(page.locator('#warning-list')).toContainText('not verified');
+});
+
+test('full snapshot PA branch requires an explicit source explosion',async({page})=>{
+  await page.goto('/');await convert(page,'1 exp Anti-Bacterial Agents/');
+  await expect(page.locator('#query')).toHaveValue('("Anti-Bacterial Agents"[mh] OR "Anti-Bacterial Agents"[pa])');
+  await convert(page,'1 Anti-Bacterial Agents/');
+  await expect(page.locator('#query')).toHaveValue('"Anti-Bacterial Agents"[mh]');
+});
